rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isMfaSignedIn() {
      return isSignedIn()
        && ('firebase' in request.auth.token)
        && ('sign_in_second_factor' in request.auth.token.firebase)
        && request.auth.token.firebase.sign_in_second_factor is string
        && request.auth.token.firebase.sign_in_second_factor.size() > 0;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isValidRoleRecord(userId, data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'active', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'active', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && data.uid == userId
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160 && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['admin', 'editor']
        && data.active is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128;
    }

    function hasActiveUserDoc() {
      return isSignedIn()
        && exists(userDocPath())
        && isValidRoleRecord(request.auth.uid, get(userDocPath()).data)
        && get(userDocPath()).data.active == true;
    }

    function isAdmin() {
      return hasActiveUserDoc() && get(userDocPath()).data.role == 'admin' && isMfaSignedIn();
    }

    function isEditor() {
      return hasActiveUserDoc() && get(userDocPath()).data.role == 'editor';
    }

    function isAdminOrEditor() {
      return isAdmin() || isEditor();
    }

    function isValidStatus(val) {
      return val is string && val in ['draft', 'published'];
    }

    function isValidDivision(val) {
      return val is string && val in ['creative', 'estudios', 'marketing', 'emtc'];
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll(['companyName', 'tagline', 'email', 'primaryPhone', 'headquartersAddress', 'socialLinks', 'impactMetrics'])
        && data.keys().hasOnly(['companyName', 'tagline', 'email', 'primaryPhone', 'secondaryPhone', 'headquartersAddress', 'campusAddress', 'socialLinks', 'impactMetrics', 'updatedAt'])
        && data.companyName is string && data.companyName.size() >= 2 && data.companyName.size() <= 120
        && data.tagline is string && data.tagline.size() >= 5 && data.tagline.size() <= 240
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.primaryPhone is string && data.primaryPhone.size() >= 5 && data.primaryPhone.size() <= 40
        && (!('secondaryPhone' in data) || (data.secondaryPhone is string && data.secondaryPhone.size() <= 40))
        && data.headquartersAddress is string && data.headquartersAddress.size() >= 5 && data.headquartersAddress.size() <= 240
        && (!('campusAddress' in data) || (data.campusAddress is string && data.campusAddress.size() <= 240))
        && data.socialLinks is map
        && data.impactMetrics is map;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['slug', 'title', 'category', 'division', 'clientName', 'summary', 'challenge', 'solution', 'deliverables', 'imageUrl', 'isPlaceholder', 'featured', 'status', 'isDeleted'])
        && data.keys().hasOnly(['slug', 'title', 'category', 'division', 'clientName', 'summary', 'challenge', 'solution', 'deliverables', 'imageUrl', 'isPlaceholder', 'featured', 'status', 'isDeleted', 'updatedAt', 'createdAt'])
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 120 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.category is string && data.category in ['Branding', 'Commercial Production', 'Photography', 'Videography', 'Influencer Campaigns', 'Events', 'Brand Activations', 'Digital Marketing']
        && isValidDivision(data.division)
        && data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 120
        && data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 600
        && data.challenge is string && data.challenge.size() >= 10 && data.challenge.size() <= 2500
        && data.solution is string && data.solution.size() >= 10 && data.solution.size() <= 2500
        && data.deliverables is list && data.deliverables.size() >= 1 && data.deliverables.size() <= 12 && data.deliverables[0] is string
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 500
        && data.isPlaceholder is bool
        && data.featured is bool
        && isValidStatus(data.status)
        && data.isDeleted is bool;
    }

    function isValidService(data) {
      return data.keys().hasAll(['division', 'title', 'problemSolved', 'description', 'order', 'status', 'isDeleted'])
        && data.keys().hasOnly(['division', 'title', 'problemSolved', 'description', 'order', 'status', 'isDeleted', 'updatedAt'])
        && isValidDivision(data.division)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.problemSolved is string && data.problemSolved.size() >= 5 && data.problemSolved.size() <= 400
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 1200
        && data.order is int && data.order >= 0 && data.order <= 999
        && isValidStatus(data.status)
        && data.isDeleted is bool;
    }

    function isValidArticle(data) {
      return data.keys().hasAll(['slug', 'title', 'category', 'excerpt', 'body', 'authorName', 'authorRole', 'publishedDate', 'readTime', 'imageUrl', 'featured', 'status', 'isDeleted'])
        && data.keys().hasOnly(['slug', 'title', 'category', 'excerpt', 'body', 'authorName', 'authorRole', 'publishedDate', 'readTime', 'imageUrl', 'featured', 'status', 'isDeleted', 'updatedAt'])
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 120 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.title is string && data.title.size() >= 4 && data.title.size() <= 180
        && data.category is string && data.category in ['Industry Articles', 'Marketing Insights', 'Creative Trends', 'Company Updates', 'Educational Content']
        && data.excerpt is string && data.excerpt.size() >= 10 && data.excerpt.size() <= 500
        && data.body is string && data.body.size() >= 20 && data.body.size() <= 20000
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 100
        && data.authorRole is string && data.authorRole.size() >= 2 && data.authorRole.size() <= 100
        && data.publishedDate is string && data.publishedDate.size() >= 4 && data.publishedDate.size() <= 40
        && data.readTime is string && data.readTime.size() >= 2 && data.readTime.size() <= 30
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 500
        && data.featured is bool
        && isValidStatus(data.status)
        && data.isDeleted is bool;
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll(['quote', 'clientName', 'clientRole', 'companyName', 'isPlaceholder', 'status', 'isDeleted'])
        && data.keys().hasOnly(['quote', 'clientName', 'clientRole', 'companyName', 'videoUrl', 'isPlaceholder', 'status', 'isDeleted', 'updatedAt'])
        && data.quote is string && data.quote.size() >= 10 && data.quote.size() <= 1000
        && data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100
        && data.clientRole is string && data.clientRole.size() >= 2 && data.clientRole.size() <= 120
        && data.companyName is string && data.companyName.size() >= 2 && data.companyName.size() <= 120
        && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 500))
        && data.isPlaceholder is bool
        && isValidStatus(data.status)
        && data.isDeleted is bool;
    }

    function isValidClientLogo(data) {
      return data.keys().hasAll(['name', 'sector', 'isPlaceholder', 'status', 'isDeleted'])
        && data.keys().hasOnly(['name', 'sector', 'region', 'logoUrl', 'isPlaceholder', 'status', 'isDeleted', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.sector is string && data.sector.size() >= 2 && data.sector.size() <= 100
        && (!('region' in data) || (data.region is string && data.region.size() <= 80))
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 500))
        && data.isPlaceholder is bool
        && isValidStatus(data.status)
        && data.isDeleted is bool;
    }

    function isValidTeamMember(data) {
      return data.keys().hasAll(['name', 'role', 'division', 'bio', 'isPlaceholder', 'status', 'isDeleted'])
        && data.keys().hasOnly(['name', 'role', 'division', 'bio', 'photoUrl', 'isPlaceholder', 'status', 'isDeleted', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.role is string && data.role.size() >= 2 && data.role.size() <= 120
        && data.division is string && data.division.size() >= 2 && data.division.size() <= 100
        && data.bio is string && data.bio.size() >= 10 && data.bio.size() <= 600
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.isPlaceholder is bool
        && isValidStatus(data.status)
        && data.isDeleted is bool;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['referenceCode', 'fullName', 'businessEmail', 'companyName', 'phone', 'industry', 'requiredServices', 'estimatedBudget', 'projectTimeline', 'projectDescription', 'consentAccepted', 'inquiryStatus', 'createdAt'])
        && data.keys().hasOnly(['referenceCode', 'fullName', 'businessEmail', 'companyName', 'phone', 'industry', 'requiredServices', 'estimatedBudget', 'projectTimeline', 'projectDescription', 'consentAccepted', 'inquiryStatus', 'createdAt'])
        && data.referenceCode is string && data.referenceCode.matches('^EMA-[0-9]{4}-[A-Z0-9]{6}$')
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.businessEmail is string && data.businessEmail.size() >= 5 && data.businessEmail.size() <= 160 && data.businessEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.companyName is string && data.companyName.size() >= 2 && data.companyName.size() <= 140
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 30
        && data.industry is string && data.industry.size() >= 2 && data.industry.size() <= 100
        && data.requiredServices is list && data.requiredServices.size() >= 1 && data.requiredServices.size() <= 20 && data.requiredServices[0] is string
        && data.estimatedBudget is string && data.estimatedBudget.size() >= 2 && data.estimatedBudget.size() <= 80
        && data.projectTimeline is string && data.projectTimeline.size() >= 2 && data.projectTimeline.size() <= 80
        && data.projectDescription is string && data.projectDescription.size() >= 10 && data.projectDescription.size() <= 3000
        && data.consentAccepted == true
        && data.inquiryStatus == 'new'
        && data.createdAt == request.time;
    }

    match /site_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create, update: if isValidId(settingId) && isAdmin() && isValidSiteSettings(incoming());
      allow delete: if false;
    }

    match /portfolio_projects/{projectId} {
      allow get: if isValidId(projectId) && ((existing().status == 'published' && existing().isDeleted == false) || isAdminOrEditor());
      allow list: if (resource.data.status == 'published' && resource.data.isDeleted == false) || isAdminOrEditor();
      allow create, update: if isValidId(projectId) && isAdminOrEditor() && isValidProject(incoming());
      allow delete: if isValidId(projectId) && isAdmin();
    }

    match /services/{serviceId} {
      allow get: if isValidId(serviceId) && ((existing().status == 'published' && existing().isDeleted == false) || isAdminOrEditor());
      allow list: if (resource.data.status == 'published' && resource.data.isDeleted == false) || isAdminOrEditor();
      allow create, update: if isValidId(serviceId) && isAdminOrEditor() && isValidService(incoming());
      allow delete: if isValidId(serviceId) && isAdmin();
    }

    match /articles/{articleId} {
      allow get: if isValidId(articleId) && ((existing().status == 'published' && existing().isDeleted == false) || isAdminOrEditor());
      allow list: if (resource.data.status == 'published' && resource.data.isDeleted == false) || isAdminOrEditor();
      allow create, update: if isValidId(articleId) && isAdminOrEditor() && isValidArticle(incoming());
      allow delete: if isValidId(articleId) && isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow get: if isValidId(testimonialId) && ((existing().status == 'published' && existing().isDeleted == false) || isAdminOrEditor());
      allow list: if (resource.data.status == 'published' && resource.data.isDeleted == false) || isAdminOrEditor();
      allow create, update: if isValidId(testimonialId) && isAdminOrEditor() && isValidTestimonial(incoming());
      allow delete: if isValidId(testimonialId) && isAdmin();
    }

    match /client_logos/{logoId} {
      allow get: if isValidId(logoId) && ((existing().status == 'published' && existing().isDeleted == false) || isAdminOrEditor());
      allow list: if (resource.data.status == 'published' && resource.data.isDeleted == false) || isAdminOrEditor();
      allow create, update: if isValidId(logoId) && isAdminOrEditor() && isValidClientLogo(incoming());
      allow delete: if isValidId(logoId) && isAdmin();
    }

    match /team_members/{memberId} {
      allow get: if isValidId(memberId) && ((existing().status == 'published' && existing().isDeleted == false) || isAdminOrEditor());
      allow list: if (resource.data.status == 'published' && resource.data.isDeleted == false) || isAdminOrEditor();
      allow create, update: if isValidId(memberId) && isAdminOrEditor() && isValidTeamMember(incoming());
      allow delete: if isValidId(memberId) && isAdmin();
    }

    match /inquiries/{inquiryId} {
      // Public inquiry creation must use the trusted server workflow.
      allow create: if false;
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin();
      // Inquiry mutations use server transactions that append audit events.
      allow update, delete: if false;
    }

    match /newsletter_subscribers/{subscriberHash} {
      // Enrollment is disabled until the full confirmation lifecycle is operational.
      allow create: if false;
      allow update: if subscriberHash.matches('^[a-f0-9]{64}$') && (
        isAdmin() || (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'unsubscribedAt'])
          && incoming().status == 'unsubscribed'
          && incoming().unsubscribeToken == existing().unsubscribeToken
          && incoming().unsubscribedAt == request.time
        )
      );
      allow get: if subscriberHash.matches('^[a-f0-9]{64}$') && isAdmin();
      allow list, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (
        (request.auth.uid == userId && isValidRoleRecord(userId, existing())) || isAdmin()
      );
      allow list: if isAdmin();
      // Role records are provisioned only by the trusted server.
      allow create, update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      // Audit records are written by trusted server operations only.
      allow create, update, delete: if false;
    }
  }
}
